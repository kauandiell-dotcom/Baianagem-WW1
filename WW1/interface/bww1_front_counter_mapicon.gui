				maxWidth = 300
				maxHeight = 40
				orientation = center
				vertical_alignment = center
				format = center
				alwaystransparent = yes
			}
		}

		iconType = {
			name = "target_flag"
			quadTextureSprite = "GFX_tiled_window_transparent"
			position = { x=0 y=0 }
			alwaystransparent = yes
		}

		iconType = {
			name = "timer_icon"
			quadTextureSprite = "GFX_tiled_window_transparent"
