guiTypes = {

	# Dummy window kept completely inactive and off-screen to avoid any screen HUD panels
	containerWindowType = {
		name = "bww1_front_counter_dummy_window"
		position = { x = -9999 y = -9999 }
		size = { width = 1 height = 1 }
		alwaystransparent = yes
	}

	# On-Map Frontline Troop Numbers:
	# Removes circular pins, buttons, and backgrounds so ONLY the giant 36pt bold white numbers render on the 3D map states
	containerWindowType = {
		name = "decision_mapicon_item"
		position = { x=0 y=0 }
		size = { width = 40 height = 40 }
		clipping = no

		buttonType = {
			name = "background_btn"
			quadTextureSprite = "GFX_tiled_window_transparent"
			position = { x=0 y=0 }
		}

		iconType = {
			name = "decision_icon"
			spriteType = "GFX_tiled_window_transparent"
			position = { x=0 y=0 }
			alwaystransparent = yes
		}

		iconType = {
			name = "progress_good"
			spriteType = "GFX_tiled_window_transparent"
			position = { x=0 y=0 }
		}

		iconType = {
			name = "progress_bad"
			spriteType = "GFX_tiled_window_transparent"
			position = { x=0 y=0 }
		}

		containerWindowType = {
			name = "cost_container"
			position = { x = 0 y = 0 }
			orientation = center
			origo = center
			clipping = no

			background = {
				name = "cost_bg"
				quadTextureSprite = "GFX_tiled_window_transparent"
			}

			positionType = {
				name = "cost_text_horizontal_margin"
				position = { x = 11 y = 11 }
			}

			instantTextboxType = {
				name = "cost_text"
