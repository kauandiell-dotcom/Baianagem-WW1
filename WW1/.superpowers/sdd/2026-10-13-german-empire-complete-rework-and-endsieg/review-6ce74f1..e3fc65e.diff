@@ -0,0 +1,32 @@
+add_namespace = ww1_germany
+
+# -------------------------------------------------------------------------
+# ww1_germany.10: Stabilization of the Western Front / Trench Warfare Begins
+# -------------------------------------------------------------------------
+country_event = {
+	id = ww1_germany.10
+	title = ww1_germany.10.t
+	desc = ww1_germany.10.d
+	picture = GFX_report_event_german_troops
+
+	fire_only_once = yes
+
+	trigger = {
+		tag = GER
+		has_country_flag = ger_schlieffen_plan_launched
+		NOT = { controls_state = 16 }
+		NOT = { has_idea = GER_schlieffen_momentum }
+		NOT = { has_idea = GER_western_trench_stalemate }
+	}
+
+	mean_time_to_happen = {
+		days = 1
+	}
+
+	option = {
+		name = ww1_germany.10.a
+		add_ideas = GER_western_trench_stalemate
+		remove_ideas = GER_schlieffen_momentum
+		add_stability = 0.05
+	}
+}
