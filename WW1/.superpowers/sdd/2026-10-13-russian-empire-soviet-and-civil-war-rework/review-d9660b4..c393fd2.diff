+# -------------------------------------------------------------
+# 1918 German Armistice / Brest-Litovsk Dissolution Scripted Effect
+# -------------------------------------------------------------
+SOV_dissolve_brest_litovsk = {
+	clr_global_flag = SOV_brest_litovsk_signed
+	set_global_flag = SOV_brest_litovsk_dissolved
+
+	if = {
+		limit = { country_exists = GER }
+		GER = {
+			remove_ideas = GER_brest_litovsk_deliveries
+		}
+	}
+
+	if = {
+		limit = { country_exists = SOV }
+		SOV = {
+			set_country_flag = SOV_target_vistula_active
+			add_political_power = 100
+		}
+	}
+}
diff --git a/WW1/events/ww1_russia_diplomacy_events.txt b/WW1/events/ww1_russia_diplomacy_events.txt
